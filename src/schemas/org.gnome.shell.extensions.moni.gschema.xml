<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.moni" path="/org/gnome/shell/extensions/moni/">
    <key name="update-interval" type="i"><default>1500</default><summary>Update interval in ms</summary></key>
    <key name="panel-position" type="s"><default>'right'</default><summary>left, center or right</summary></key>
    <key name="style" type="s"><default>'color'</default><summary>color (Apple system colors) or mono (grays only)</summary></key>
    <key name="graph-width" type="i"><default>28</default><summary>Panel graph width in px</summary></key>
    <key name="show-text" type="b"><default>true</default><summary>Show numbers next to graphs</summary></key>
    <key name="show-cpu" type="b"><default>true</default><summary>Show CPU</summary></key>
    <key name="show-ram" type="b"><default>true</default><summary>Show memory</summary></key>
    <key name="show-gpu" type="b"><default>true</default><summary>Show GPU</summary></key>
    <key name="show-net" type="b"><default>true</default><summary>Show network</summary></key>
    <key name="show-disk" type="b"><default>true</default><summary>Show disk usage</summary></key>
    <key name="show-ip" type="b"><default>true</default><summary>Show IP address</summary></key>
    <key name="show-ros" type="b"><default>true</default><summary>ROS 2 node radar</summary></key>
    <key name="show-rosbag" type="b"><default>true</default><summary>rosbag recording badge</summary></key>
    <key name="show-can" type="b"><default>true</default><summary>CAN bus monitor</summary></key>
    <key name="show-devices" type="b"><default>true</default><summary>Sensor device list</summary></key>
    <key name="show-pm2" type="b"><default>true</default><summary>PM2 process monitor</summary></key>
    <key name="notify-pm2" type="b"><default>true</default><summary>Notify when a PM2 app crashes or errors</summary></key>
    <key name="show-docker" type="b"><default>true</default><summary>Docker container monitor</summary></key>
    <key name="notify-docker" type="b"><default>true</default><summary>Notify when a container dies, restarts or turns unhealthy</summary></key>
    <key name="notify-devices" type="b"><default>true</default><summary>Notify on device plug/unplug</summary></key>
    <key name="internet-probe" type="b"><default>true</default><summary>Measure internet latency</summary></key>
    <key name="probe-host" type="s"><default>'1.1.1.1'</default><summary>Latency probe host (TCP 443)</summary></key>
    <key name="screenshot-shortcut" type="as"><default><![CDATA[['<Super><Shift>s']]]></default><summary>Capture an area and open the editor</summary></key>
    <key name="record-shortcut" type="as"><default><![CDATA[['<Super><Shift>d']]]></default><summary>Start / stop screen recording</summary></key>
    <key name="show-clipboard" type="b"><default>true</default><summary>Clipboard history panel icon</summary></key>
    <key name="clipboard-shortcut" type="as"><default><![CDATA[['<Super><Shift>v']]]></default><summary>Open clipboard history</summary></key>
    <key name="clipboard-size" type="i"><default>50</default><summary>Recent items kept (memory only)</summary></key>
    <key name="clipboard-paste" type="b"><default>true</default><summary>Paste into the focused window on pick</summary></key>
    <key name="clipboard-favorites" type="as"><default>[]</default><summary>Starred clipboard items</summary></key>
    <key name="show-quick" type="b"><default>true</default><summary>Quick copy buttons in the top bar</summary></key>
    <key name="quick-action" type="s"><default>'both'</default><summary>On click: copy, paste (at the cursor) or both</summary></key>
    <key name="quick-items" type="s"><default>'[]'</default><summary>Quick copy items as JSON: [{"icon": "GH", "image": "/path.png", "text": "…"}]</summary></key>
    <key name="ocr" type="b"><default>false</default><summary>Text recognition (OCR) and QR codes in screenshots</summary></key>
    <key name="update-check" type="b"><default>true</default><summary>Check GitHub once a day for a new release</summary></key>
    <key name="update-auto" type="b"><default>false</default><summary>Install new releases without asking</summary></key>
    <key name="update-last-check" type="x"><default>0</default><summary>Unix time of the last update check</summary></key>
    <key name="update-notified" type="s"><default>''</default><summary>Last release version already announced</summary></key>
    <key name="record-cursor" type="b"><default>true</default><summary>Show the pointer in recordings</summary></key>
  </schema>
</schemalist>
